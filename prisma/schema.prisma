// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}

// MUDANÇA AQUI: Altere o provider para "mysql"
datasource db {
  provider = "mysql" 
  url      = env("DATABASE_URL")
}

// Seu modelo de dados 'User' permanece o mesmo
 
model User {
  id              String      @id @default(cuid()) 
  name            String      @map("nome") 
  email           String      @unique 
  password        String? 
  image           String? 
  emailVerified   DateTime?
  userType        UserType    @map("tipo_usuario")
  age             Int?        @map("idade")
  createdAt       DateTime    @default(now()) @map("data_cadastro") 
  
  @@map("users") 
}

enum UserType {
  PESCADOR
  TRAVESSANTE // Termo corrigido!
}